# This is a dev-tooling repo (single self-contained dist bundle, no
# npm-installed runtime), so devDependencies are always required — never
# omit them, even when NODE_ENV=production is set in the shell (npm's
# default in that case is to omit dev deps, which would silently drop
# vite/vitest/eslint/typescript/prettier and break `make check`).
include=dev
